{
  "name": "starter-kit",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend/*",
    "apps/backend/*",
    "packages/frontend/*",
    "packages/backend/*",
    "packages/shared/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "@hono/node-server": "^1.19.11",
    "defu": "^6.1.7",
    "hono": "^4.12.5",
    "kysely": "^0.28.15",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^2.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md}": [
      "bun format:fix",
      "bun lint:fix"
    ]
  },
  "engines": {
    "bun": "1.3.11"
  },
  "packageManager": "bun@1.3.14"
}
