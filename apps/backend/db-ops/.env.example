# ---------------------------------------------------------------------------
# db-ops environment — copy to .env and adjust values as needed.
# Required variables are validated by the TypeBox schema in
# src/core/services/config (missing required vars fail fast at boot).
# ---------------------------------------------------------------------------

# One of: development | production | staging | test (required by the config schema)
# The dev/start scripts set this automatically; only set it here for custom scripts or CI.
# NODE_ENV=development
# Optional: time zone for this process
# TZ=Asia/Shanghai

# --- Database (required) -----------------------------------------------------
# Postgres connection string for the gateway database. Matches the
# docker-compose instance (user: postgres, password: root, database: db-gateway).
# Keep in sync with DATABASE_URL in apps/backend/api-gateway/.env.
# Note: the database must already exist (e.g. `docker compose exec tamtt-postgres psql -U postgres -c 'CREATE DATABASE db-gateway'`).
GATEWAY_DATABASE_URL=postgresql://postgres:root@localhost:5432/db-gateway
