{
  "name": "@tamtt-labs/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./tailwind.css": {
        "style": "./dist/tailwind.css",
        "default": "./dist/tailwind.css"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "bun run build -- --watch",
    "build": "bun --bun tsdown --tsconfig tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-animated": "^1.0.0",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tamtt-labs/tsconfig": "workspace:*",
    "@tamtt-labs/tsdown": "workspace:*",
    "@types/bun": "^1.3.11",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
