{
  "name": "@tamtt-labs/db-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "build": "bun build --compile --minify-whitespace --minify-syntax --outfile ./dist/db-ops src/index.ts",
    "start": "NODE_ENV=production ./dist/db-ops",
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "@tamtt-labs/cqrs": "workspace:*",
    "@tamtt-labs/ddd": "workspace:*",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@tamtt-labs/tsconfig": "workspace:*",
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.9"
  }
}
