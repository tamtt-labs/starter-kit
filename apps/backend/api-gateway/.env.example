# ---------------------------------------------------------------------------
# api-gateway environment — copy to .env and adjust values as needed.
# Required variables are validated by the TypeBox schema in
# src/core/shared/modules/config (missing required vars fail fast at boot).
# ---------------------------------------------------------------------------

# One of: development | production | staging | test (required by the config schema)
# The dev/start scripts set this automatically; only set it here for custom scripts or CI.
# NODE_ENV=development
# Optional: time zone for this process
# TZ=Asia/Shanghai

# --- Application (required) -------------------------------------------------
# Port the Elysia gateway listens on
APP_PORT=3001
# Display name for the app (used by better-auth, OpenAPI docs, etc.)
APP_NAME=api-gateway
# Public origin of the frontend — used for CORS and auth callbacks
APP_ORIGIN=http://localhost:3000

# --- Better-Auth (required) --------------------------------------------------
# Cryptographically random secret for signing auth/session cookies.
# Generate a new one per deployment: `openssl rand -hex 32`. NEVER reuse across environments.
AUTH_SECRET=f550d74047526642ad2a4d265121056abb5d2564a6c73940b23d557b069dc2a5
# Session lifetime in MILLISECONDS (default below: 30 days)
AUTH_SESSION_EXPIRES_IN=2592000000
# Session cookie cache lifetime in MILLISECONDS (default below: 1 day)
AUTH_SESSION_CACHE_MAX_AGE=86400000
# One-time-code lifetime in SECONDS (default below: 10 minutes)
AUTH_OTP_EXPIRES_IN=600

# --- Database (required) -----------------------------------------------------
# Postgres connection string. Matches the docker-compose instance
# (user: postgres, password: root, database: db-gateway).
# The database must exist before dev/migration:generate (see README, "Getting started").
DATABASE_URL=postgresql://postgres:root@localhost:5432/db-gateway
