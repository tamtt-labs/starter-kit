# ---------------------------------------------------------------------------
# web-app environment — copy to .env and adjust values as needed.
# Required variables are validated by the TypeBox schema in
# src/core/shared/modules/config (missing required vars fail fast at boot).
# ---------------------------------------------------------------------------

# One of: development | production | staging | test (required by the config schema)
# The dev/start scripts set this automatically; only set it here for custom scripts or CI.
# NODE_ENV=development
# Optional: time zone for this process
# TZ=Asia/Shanghai

# --- Application (required) --------------------------------------------------
# Public origin of the web application — used for client-server communication
# (base URL of the SPA or SSR pages)
APP_ORIGIN=http://localhost:3000
